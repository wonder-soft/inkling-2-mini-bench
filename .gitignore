# --- never commit: secrets and host-specific config --------------------------
.env
.env.*
!.env.example
serving/env.sh
opencode/opencode.json
*.pem
*.key
id_rsa*
id_ed25519*

# --- never commit: data that is not ours to publish --------------------------
# Anything that is not generated by ocr/gen_synthetic.py or a public dataset
# goes here. It is ignored as a whole so a stray file cannot slip in.
ocr/data/private/
ocr/data/public/*/
ocr/data/synth/

# --- weights and build output ------------------------------------------------
*.gguf
*.gguf_file
*.safetensors
models/
__pycache__/
*.pyc
.DS_Store
/target/
results/**/target/
results/**/.scala-build/
results/**/__pycache__/
results/**/.pytest_cache/
results/**/Cargo.lock
results/**/task_api
output/**/target/
output/**/.bsp/
output/**/.scala-build/
output/**/.metals/
output/**/.bloop/

# --- raw logs (summaries and reports are committed, raw streams are not) -----
results/*.log
results/**/*.log
results/**/raw/
